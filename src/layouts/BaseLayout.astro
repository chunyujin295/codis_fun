---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/lib/constants";

export interface Props {
  title: string;
  description?: string;
  /** If true, uses narrower single-column reading layout */
  isArticle?: boolean;
}
const { title, description = SITE.description, isArticle = false } = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
---

<!DOCTYPE html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.title} />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <title>{fullTitle}</title>

    <!-- Favicon — simple SVG circle -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main class:list={["container", { "is-article": isArticle }]}>
      <slot />
    </main>
    <Footer author={SITE.author} />
  </body>
</html>

<style is:global>
  /* Article layout — narrower for reading */
  .container.is-article {
    max-width: var(--max-width-content);
    padding-block: var(--space-3xl);
  }

  .container:not(.is-article) {
    padding-block: 0;
  }
</style>
