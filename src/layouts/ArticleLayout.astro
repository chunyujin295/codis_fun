---
import BaseLayout from "@/layouts/BaseLayout.astro";

export interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  cover?: string;
}

const { title, description, date, tags = [], cover } = Astro.props;
---

<BaseLayout title={title} description={description} isArticle={true}>
  <article class="article">
    <header class="article-header">
      <a href="/" class="back-link" aria-label="返回首页">&larr; 首页</a>

      {date && (
        <time class="article-date" datetime={date.toISOString()}>
          {date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}

      <h1 class="article-title">{title}</h1>

      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {cover && (
      <div class="article-cover">
        <img src={cover} alt={title} loading="eager" />
      </div>
    )}

    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: var(--max-width-content);
    margin-inline: auto;
  }

  .article-header {
    margin-bottom: var(--space-2xl);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .article-date {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .article-cover {
    margin-bottom: var(--space-2xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 480px;
    object-fit: cover;
  }

  .article-body {
    font-family: var(--font-serif);
    /* Prose styles from markdown.css handle content styling */
  }
</style>
