---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TocSidebar from "@/components/TocSidebar.astro";
import "katex/dist/katex.min.css";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  cover?: string;
  headings?: Heading[];
}

const { title, description, date, tags = [], cover, headings = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {headings.length > 0 && (
    <TocSidebar headings={headings} />
  )}

  <div class="article-wrapper" class:list={[{ "has-toc": headings.length > 0 }]}>
    <article class="article">
      {cover && (
        <div class="article-cover">
          <img src={cover} alt={title} loading="eager" />
        </div>
      )}

      <header class="article-header">
        <a href="/" class="back-link" aria-label="返回首页">&larr;</a>

        {date && (
          <time class="article-date" datetime={date.toISOString()}>
            {date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}

        <h1 class="article-title">{title}</h1>

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="article-body">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: var(--max-width-site);
    margin-inline: auto;
    padding-block: var(--space-3xl);
  }

  .article-wrapper.has-toc {
    padding-left: min(360px, calc((100vw - var(--max-width-content)) / 2 - 2rem));
  }

  .article {
    max-width: var(--max-width-content);
    margin-inline: auto;
  }

  .article-wrapper.has-toc .article {
    margin-inline: 0;
  }

  .article-header {
    margin-bottom: var(--space-2xl);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .article-date {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .article-cover {
    margin-bottom: var(--space-2xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    width: 100%;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 480px;
    object-fit: cover;
  }

  .article-body {
    font-family: var(--font-serif);
  }

  @media (max-width: 900px) {
    .article-wrapper.has-toc {
      padding-left: 0;
    }
  }
</style>
