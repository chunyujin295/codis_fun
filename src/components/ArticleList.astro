---
import ArticleCard from "@/components/ArticleCard.astro";

export interface ArticleItem {
  title: string;
  date: string;
  slug: string;
  excerpt?: string;
}

export interface Props {
  articles: ArticleItem[];
  heading?: string;
  /** Total count across all pages (shown instead of current page count when set) */
  totalCount?: number;
  /** Reduce bottom padding for compact placement */
  compact?: boolean;
}

const { articles, heading = "Notes", totalCount, compact = false } = Astro.props;
const count = totalCount ?? articles.length;
---

<section id="articles" class:list={["article-section", { compact }]}>
  <h2 class="section-title">
    {heading}
    {count > 0 && (
      <span class="section-count">{count}</span>
    )}
  </h2>

  {articles.length > 0 ? (
    <div class="article-list">
      {articles.map((article) => (
        <ArticleCard
          title={article.title}
          date={article.date}
          slug={article.slug}
          excerpt={article.excerpt}
        />
      ))}
    </div>
  ) : (
    <p class="empty-text">还没有文章，敬请期待。</p>
  )}
</section>

<style>
  .article-section {
    padding-bottom: var(--space-3xl);
  }

  .article-section.compact {
    padding-bottom: 0;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
  }

  .section-count {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
    margin-left: var(--space-sm);
    vertical-align: middle;
  }

  .empty-text {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
  }
</style>
