<button
  class="search-trigger"
  id="search-trigger"
  aria-label="搜索"
  title="搜索"
  type="button"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.35-4.35"/>
  </svg>
</button>

<!-- Search modal overlay -->
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-backdrop"></div>
  <div class="search-modal" role="dialog" aria-label="搜索文章">
    <div class="search-modal-header">
      <input
        type="search"
        class="search-modal-input"
        id="search-modal-input"
        placeholder="搜索…"
        autocomplete="off"
        autofocus
      />
      <button class="search-modal-close" id="search-modal-close" aria-label="关闭搜索" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
    <div class="search-modal-body" id="search-modal-body"></div>
  </div>
</div>

<script>
  interface Article {
    title: string;
    slug: string;
    date: string;
    excerpt: string;
    tags: string[];
    snippet: string;
  }

  let index: Article[] | null = null;
  let loading = false;
  let activeIdx = -1;

  const trigger = document.getElementById("search-trigger") as HTMLButtonElement;
  const overlay = document.getElementById("search-overlay") as HTMLDivElement;
  const input = document.getElementById("search-modal-input") as HTMLInputElement;
  const body = document.getElementById("search-modal-body") as HTMLDivElement;
  const closeBtn = document.getElementById("search-modal-close") as HTMLButtonElement;

  function open() {
    overlay.hidden = false;
    document.body.style.overflow = "hidden";
    setTimeout(() => input.focus(), 80);
    loadIndex();
  }

  function close() {
    overlay.hidden = true;
    document.body.style.overflow = "";
    input.value = "";
    body.innerHTML = "";
    activeIdx = -1;
  }

  trigger.addEventListener("click", open);
  closeBtn.addEventListener("click", close);
  overlay.querySelector(".search-backdrop")!.addEventListener("click", close);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay.hidden) close();
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      open();
    }
  });

  function norm(s: string): string {
    return s.toLowerCase().replace(/[\s\-_.,;:!?()（）【】「」『』""'']+/g, "");
  }

  function score(query: string, target: string): number {
    const q = norm(query);
    const t = norm(target);
    if (!q || !t) return 0;
    if (t === q) return 100;
    if (t.startsWith(q)) return 80;
    if (t.includes(q)) return 60;
    let qi = 0;
    for (let ti = 0; ti < t.length && qi < q.length; ti++) {
      if (t[ti] === q[qi]) qi++;
    }
    if (qi === q.length) return 30 + (q.length / t.length) * 20;
    return 0;
  }

  function search(query: string) {
    if (!index || query.trim().length < 1) return [];
    const hits: { article: Article; score: number }[] = [];
    for (const a of index) {
      const s = Math.max(
        score(query, a.title) * 2,
        score(query, a.excerpt),
        score(query, a.snippet),
        score(query, a.tags.join(" ")),
      );
      if (s > 0) hits.push({ article: a, score: s });
    }
    hits.sort((a, b) => b.score - a.score);
    return hits.slice(0, 10);
  }

  async function loadIndex() {
    if (index || loading) return;
    loading = true;
    try {
      const resp = await fetch("/search-index.json");
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      index = await resp.json();
    } catch (err) {
      console.warn("[search] Failed to load index:", err);
      index = [];
    } finally {
      loading = false;
    }
  }

  function render(hits: { article: Article; score: number }[]) {
    activeIdx = -1;
    if (input.value.trim() === "") {
      body.innerHTML = "";
      return;
    }
    if (hits.length === 0) {
      body.innerHTML = '<div class="search-empty">∅</div>';
      return;
    }

    const ul = document.createElement("ul");
    ul.className = "search-result-list";
    ul.setAttribute("role", "listbox");

    hits.forEach((hit, i) => {
      const li = document.createElement("li");
      li.className = "search-result-item";
      li.setAttribute("role", "option");
      li.dataset.index = String(i);

      const a = document.createElement("a");
      a.href = `/articles/${hit.article.slug}/`;
      a.className = "search-result-link";

      const title = document.createElement("span");
      title.className = "search-result-title";
      title.textContent = hit.article.title;

      const meta = document.createElement("span");
      meta.className = "search-result-meta";
      const parts: string[] = [];
      if (hit.article.date) parts.push(hit.article.date);
      if (hit.article.tags.length) parts.push(hit.article.tags.slice(0, 3).join(" · "));
      meta.textContent = parts.join("  /  ");

      a.appendChild(title);
      a.appendChild(meta);
      li.appendChild(a);
      ul.appendChild(li);
    });

    body.innerHTML = "";
    body.appendChild(ul);
  }

  input.addEventListener("input", async () => {
    await loadIndex();
    render(search(input.value));
  });

  input.addEventListener("keydown", (e) => {
    const items = body.querySelectorAll(".search-result-item");
    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (items.length === 0) return;
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (items.length === 0) return;
      activeIdx = Math.max(activeIdx - 1, 0);
    } else if (e.key === "Enter") {
      if (activeIdx >= 0) {
        e.preventDefault();
        const link = items[activeIdx]?.querySelector("a");
        if (link) { link.click(); close(); }
      }
      return;
    } else {
      return;
    }
    items.forEach((el, i) => {
      el.setAttribute("aria-selected", String(i === activeIdx));
      el.classList.toggle("search-result-active", i === activeIdx);
      if (i === activeIdx) (el.querySelector("a") as HTMLAnchorElement)?.focus();
    });
  });
</script>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition), background-color var(--transition);
  }

  .search-trigger:hover {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  /* Overlay */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 16vh;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  [data-theme="dark"] .search-backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  /* Modal */
  .search-modal {
    position: relative;
    width: 640px;
    max-width: calc(100vw - 40px);
    max-height: 64vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }

  [data-theme="dark"] .search-modal {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .search-modal-header {
    display: flex;
    align-items: center;
    gap: 0;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .search-modal-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 300;
    outline: none;
    padding: var(--space-sm) 0;
  }

  .search-modal-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--transition);
  }

  .search-modal-close:hover {
    color: var(--color-text);
  }

  .search-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-sm) 0;
  }

  .search-empty {
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  .search-result-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-result-item {
    border-bottom: 1px solid var(--color-border);
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-md) var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition);
  }

  .search-result-link:hover,
  .search-result-item.search-result-active .search-result-link {
    background: var(--color-surface);
  }

  .search-result-title {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .search-result-meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .search-modal {
      max-height: 72vh;
    }

    .search-overlay {
      padding-top: 8vh;
    }
  }
</style>
