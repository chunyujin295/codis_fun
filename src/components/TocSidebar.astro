---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{items.length > 0 && (
  <nav class="toc" aria-label="目录" id="toc-nav">
    <div class="toc-inner">
      <button
        class="toc-toggle"
        id="toc-toggle"
        aria-label="展开目录"
        aria-expanded="true"
        title="折叠目录"
        type="button"
      >&#8250;</button>

      <ul class="toc-list" id="toc-list">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class={`toc-link toc-depth-${h.depth}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  const toggle = document.getElementById("toc-toggle") as HTMLButtonElement;
  const list = document.getElementById("toc-list") as HTMLUListElement;
  const nav = document.getElementById("toc-nav") as HTMLElement;

  let expanded = true;

  toggle.addEventListener("click", () => {
    expanded = !expanded;
    toggle.setAttribute("aria-expanded", String(expanded));
    toggle.setAttribute("aria-label", expanded ? "折叠目录" : "展开目录");
    toggle.title = expanded ? "折叠目录" : "展开目录";
    toggle.innerHTML = expanded ? "&#8250;" : "&#8249;";
    nav.classList.toggle("toc-collapsed", !expanded);
  });

  // Active heading tracking
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const link = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
        if (link) {
          link.classList.toggle("toc-active", entry.isIntersecting);
        }
      }
    },
    { rootMargin: "-80px 0px -60% 0px" },
  );

  for (const link of links) {
    const id = link.getAttribute("href")?.slice(1);
    if (id) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>

<style>
  .toc {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    /* width fills the left margin gap, minus gap to article */
    width: min(360px, calc((100vw - var(--max-width-content)) / 2 - 2rem));
    min-width: 200px;
    transform: translateX(0);
    transition: transform 300ms ease;
  }

  .toc-collapsed {
    transform: translateX(calc(-100% + 30px));
  }

  .toc-inner {
    display: flex;
    flex-direction: row-reverse;
    height: 100%;
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
  }

  /* Toggle tab on the right edge */
  .toc-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 28px;
    padding-top: var(--space-lg);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    cursor: pointer;
    transition: color var(--transition);
    writing-mode: horizontal-tb;
  }

  .toc-toggle:hover {
    color: var(--color-text);
  }

  .toc-collapsed .toc-toggle {
    opacity: 0.7;
  }

  .toc-collapsed .toc-toggle:hover {
    opacity: 1;
  }

  /* Scrollable list area */
  .toc-list {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: var(--space-lg) var(--space-sm) var(--space-lg) var(--space-lg);
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* Hide list in collapsed state */
  .toc-collapsed .toc-list {
    opacity: 0;
    pointer-events: none;
  }

  .toc-link {
    display: block;
    padding: 0.4em var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color var(--transition), background-color var(--transition);
    line-height: var(--leading-snug);
    word-break: break-word;
  }

  /* Full-row backgrounds by depth */
  .toc-depth-2 {
    padding-left: 0.5rem;
  }

  .toc-depth-3 {
    padding-left: 1.2rem;
    background: var(--color-surface);
  }

  .toc-depth-4 {
    padding-left: 1.8rem;
    background: var(--color-border);
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link.toc-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 400;
    background: var(--color-surface);
  }

  .toc-depth-4.toc-active {
    background: var(--color-border);
    filter: brightness(1.05);
  }

  /* Scrollbar — thin, square, theme-colored */
  .toc-list::-webkit-scrollbar {
    width: 4px;
  }

  .toc-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 0;
  }

  .toc-list::-webkit-scrollbar-button {
    display: none;
  }

  /* Firefox */
  .toc-list {
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }
  }
</style>
