---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import TagSidebar from "@/components/TagSidebar.astro";
import ArticleList from "@/components/ArticleList.astro";
import { SITE } from "@/lib/constants";
import { getSlug, formatDate, getArticleTags } from "@/lib/utils";

// Fetch all published articles at build time
const allArticles = await getCollection(
  "articles",
  ({ data }) => !data.draft,
);

// Sort by sticky (desc), then date (desc)
const sorted = [...allArticles].sort((a, b) => {
  const sa = a.data.sticky ?? 0;
  const sb = b.data.sticky ?? 0;
  if (sa !== sb) return sb - sa;
  return b.data.date.getTime() - a.data.date.getTime();
});

// Collect all unique tags across all articles
const allTags = [
  ...new Set(allArticles.flatMap((a) => getArticleTags(a))),
].sort((a, b) => a.localeCompare(b, "zh-CN"));

// Format articles for display
const formattedArticles = sorted.map((article) => ({
  title: article.data.title,
  date: formatDate(article.data.date),
  slug: getSlug(article.id),
  excerpt: article.data.excerpt,
}));
---

<BaseLayout title={SITE.title}>
  <Hero />
  <div class="content-row">
    <TagSidebar tags={allTags} />
    <div class="main-col">
      <ArticleList articles={formattedArticles} />
    </div>
  </div>
</BaseLayout>

<style>
  .content-row {
    display: flex;
    gap: var(--sidebar-gap);
    align-items: flex-start;
    padding-bottom: var(--space-3xl);
  }

  .main-col {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 640px) {
    .content-row {
      flex-direction: column;
    }

    .main-col {
      width: 100%;
    }
  }
</style>
