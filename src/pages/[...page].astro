---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import TagSidebar from "@/components/TagSidebar.astro";
import ArticleList from "@/components/ArticleList.astro";
import { SITE } from "@/lib/constants";
import { getSlug, formatDate, getArticleTags } from "@/lib/utils";

export async function getStaticPaths({ paginate }: any) {
  // Page size tuned so the article list visually balances
  // against the tag sidebar (~2x sidebar height).
  const PAGE_SIZE = 25;

  const allArticles = await getCollection(
    "articles",
    ({ data }) => !data.draft,
  );

  const sorted = [...allArticles].sort((a: any, b: any) => {
    const sa = a.data.sticky ?? 0;
    const sb = b.data.sticky ?? 0;
    if (sa !== sb) return sb - sa;
    return b.data.date.getTime() - a.data.date.getTime();
  });

  return paginate(sorted, { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
const { currentPage, lastPage } = page;
const articles: any[] = page.data;
const isFirstPage = currentPage === 1;
const hasPinned = isFirstPage && articles.some((a) => (a.data.sticky ?? 0) > 0);

// Pinned articles only shown on page 1
const pinnedArticles = hasPinned
  ? articles.filter((a) => (a.data.sticky ?? 0) > 0)
  : [];
const normalArticles = hasPinned
  ? articles.filter((a) => (a.data.sticky ?? 0) <= 0)
  : articles;

// Tags come from the full collection (getCollection is cached internally by Astro)
const fullCollection = await getCollection(
  "articles",
  ({ data }) => !data.draft,
);
const allTags = [
  ...new Set(fullCollection.flatMap((a: any) => getArticleTags(a))),
].sort((a: any, b: any) => a.localeCompare(b, "zh-CN"));

function formatArticle(article: any) {
  return {
    title: article.data.title,
    date: formatDate(article.data.date),
    slug: getSlug(article.id),
    excerpt: article.data.excerpt,
  };
}

const formattedPinned = pinnedArticles.map(formatArticle);
const formattedNormal = normalArticles.map(formatArticle);

// Total counts across all pages
const totalPinned = fullCollection.filter((a: any) => (a.data.sticky ?? 0) > 0).length;
const totalNormal = fullCollection.length - totalPinned;
---

<BaseLayout title={currentPage > 1 ? `${SITE.title} · 第 ${currentPage} 页` : SITE.title}>
  {
    isFirstPage && <Hero />
  }
  <div class="content-row">
    <TagSidebar tags={allTags} />
    <div class="main-col">
      {formattedPinned.length > 0 && (
        <>
          <ArticleList articles={formattedPinned} heading="📌 置顶" totalCount={totalPinned} compact />
          <div class="pinned-divider" aria-hidden="true"></div>
        </>
      )}
      <ArticleList
        articles={formattedNormal}
        heading={formattedPinned.length > 0 ? "笔记" : "Notes"}
        totalCount={totalNormal}
      />

      {/* Pagination controls */}
      {lastPage > 1 && (
        <nav class="pagination" aria-label="分页导航">
          {currentPage > 1 ? (
            <a
              href={currentPage === 2 ? "/" : `/${currentPage - 1}/`}
              class="page-link prev"
              rel="prev"
              aria-label="上一页"
            >
              &larr;
            </a>
          ) : (
            <span class="page-link prev disabled" aria-hidden="true">&larr;</span>
          )}

          <span class="page-info">
            {currentPage} / {lastPage}
          </span>

          {currentPage < lastPage ? (
            <a
              href={`/${currentPage + 1}/`}
              class="page-link next"
              rel="next"
              aria-label="下一页"
            >
              &rarr;
            </a>
          ) : (
            <span class="page-link next disabled" aria-hidden="true">&rarr;</span>
          )}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .content-row {
    display: flex;
    gap: var(--sidebar-gap);
    align-items: flex-start;
    padding-bottom: var(--space-3xl);
  }

  .main-col {
    flex: 1;
    min-width: 0;
  }

  .pinned-divider {
    margin: var(--space-sm) 0 var(--space-md);
    border: none;
    border-top: 1px dashed var(--color-border);
    opacity: 0.6;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .page-link {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 300;
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color var(--transition);
    padding: var(--space-xs) var(--space-sm);
  }

  .page-link:hover {
    color: var(--color-accent);
  }

  .page-link.disabled {
    color: var(--color-text-muted);
    opacity: 0.4;
    cursor: default;
  }

  .page-info {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .content-row {
      flex-direction: column;
    }

    .main-col {
      width: 100%;
    }

    .pagination {
      gap: var(--space-md);
    }
  }
</style>
